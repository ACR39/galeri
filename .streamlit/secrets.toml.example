# gallery_title = "Galeri Foto Keluarga"
# gallery_subtitle = "Momen berharga kita bersama"
# images_per_row = 3
# allow_download = true


# ══════════════════════════════════════════════════════════════════════════════
# PROVIDER BUILT-IN (Google Drive, Cloudinary, Yandex)
# ══════════════════════════════════════════════════════════════════════════════

# ─── GOOGLE DRIVE (via Service Account) ───────────────────────────────────────
# [gdrive_1]
# label = "Google Drive Utama"
# folder_id = "1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms"
# credentials_json = '{"type":"service_account","project_id":"...","private_key":"..."}'

# [gdrive_2]
# label = "Google Drive Backup"
# folder_id = "FOLDER_ID_AKUN_2"
# credentials_json = '{"type":"service_account",...}'


# ─── CLOUDINARY ───────────────────────────────────────────────────────────────
# [cloudinary_1]
# label = "Cloudinary"
# cloud_name = "namakamu"
# api_key = "123456789"
# api_secret = "abcdef..."


# ─── YANDEX DISK ─────────────────────────────────────────────────────────────
# [yandex_1]
# label = "Yandex Disk"
# oauth_token = "y0_AgAAAA..."
# base_folder = "Galeri"


# ══════════════════════════════════════════════════════════════════════════════
# RCLONE PROVIDER (70+ storage backend)
# Gunakan [rclone_1], [rclone_2], dst. untuk setiap remote
# ══════════════════════════════════════════════════════════════════════════════

# Field wajib:
#   remote_name     = nama remote dalam config rclone
#   config          = isi konfigurasi rclone (bisa didapat dari: rclone config show)
#
# Field opsional:
#   label           = nama tampilan di UI (default: "Rclone Remote #N")
#   base_path       = folder dasar di remote (default: "Galeri")
#   public_url_type = "link" | "s3" | "dropbox" | "proxy"  (default: "link")
#                     "link"    → pakai rclone link (GDrive, OneDrive, Dropbox, dll.)
#                     "s3"      → S3-compatible (AWS, Wasabi, R2, MinIO, dll.)
#                     "dropbox" → Dropbox direct download URL
#                     "proxy"   → tidak ada URL publik, file diproxy via app


# ─── CONTOH: Google Drive via rclone ──────────────────────────────────────────
# (alternatif dari gdrive_1 di atas, tidak perlu service account)
# Setup: jalankan `rclone config` di PC, lalu copy hasilnya ke sini
#
# [rclone_1]
# label           = "Google Drive (rclone)"
# remote_name     = "gdrive"
# base_path       = "Galeri"
# public_url_type = "link"
# config          = '''
# [gdrive]
# type = drive
# scope = drive
# token = {"access_token":"ya29.xxx","token_type":"Bearer","refresh_token":"1//xxx","expiry":"2024-01-01T00:00:00Z"}
# root_folder_id = 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# '''


# ─── CONTOH: OneDrive ─────────────────────────────────────────────────────────
# [rclone_2]
# label           = "OneDrive Pribadi"
# remote_name     = "onedrive"
# base_path       = "Galeri"
# public_url_type = "link"
# config          = '''
# [onedrive]
# type = onedrive
# token = {"access_token":"xxx","refresh_token":"xxx","expiry":"2024-01-01T00:00:00Z"}
# drive_id = b!xxxxxxxxxxxxxx
# drive_type = personal
# '''


# ─── CONTOH: Dropbox ──────────────────────────────────────────────────────────
# [rclone_3]
# label           = "Dropbox"
# remote_name     = "dropbox"
# base_path       = "Galeri"
# public_url_type = "dropbox"
# config          = '''
# [dropbox]
# type = dropbox
# token = {"access_token":"xxx","token_type":"Bearer","refresh_token":"xxx","expiry":"2024-01-01T00:00:00Z"}
# '''


# ─── CONTOH: Amazon S3 ────────────────────────────────────────────────────────
# [rclone_4]
# label           = "Amazon S3"
# remote_name     = "s3"
# base_path       = "galeri-bucket/Galeri"
# public_url_type = "s3"
# config          = '''
# [s3]
# type = s3
# provider = AWS
# access_key_id = AKIAIOSFODNN7EXAMPLE
# secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# region = ap-southeast-1
# acl = public-read
# '''


# ─── CONTOH: Backblaze B2 ─────────────────────────────────────────────────────
# [rclone_5]
# label           = "Backblaze B2 (10GB gratis)"
# remote_name     = "b2"
# base_path       = "nama-bucket/Galeri"
# public_url_type = "link"
# config          = '''
# [b2]
# type = b2
# account = YOUR_ACCOUNT_ID
# key = YOUR_APPLICATION_KEY
# '''


# ─── CONTOH: MEGA ─────────────────────────────────────────────────────────────
# (MEGA tidak punya URL publik langsung → gunakan proxy)
# [rclone_6]
# label           = "MEGA (20GB gratis)"
# remote_name     = "mega"
# base_path       = "Galeri"
# public_url_type = "proxy"
# config          = '''
# [mega]
# type = mega
# user = email@example.com
# pass = RCLONE_OBSCURED_PASSWORD
# '''


# ─── CONTOH: FTP/SFTP ─────────────────────────────────────────────────────────
# [rclone_7]
# label           = "Server FTP"
# remote_name     = "myftp"
# base_path       = "/public_html/galeri"
# public_url_type = "proxy"
# config          = '''
# [myftp]
# type = ftp
# host = ftp.server.com
# user = ftpuser
# pass = RCLONE_OBSCURED_PASSWORD
# port = 21
# '''


# ─── CARA MENDAPATKAN RCLONE CONFIG ───────────────────────────────────────────
# 1. Install rclone: https://rclone.org/install/
# 2. Jalankan: rclone config  → ikuti wizard interaktif
# 3. Setelah selesai, jalankan: rclone config show
# 4. Copy bagian [nama_remote] yang relevan ke secrets.toml
